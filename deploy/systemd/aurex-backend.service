[Unit]
Description=Aurex Python Backend API
After=network.target postgresql.service redis.service

[Service]
Type=notify
User=aurex
Group=aurex
WorkingDirectory=/var/www/aurex/python-backend

# Environment
Environment="PATH=/var/www/aurex/python-backend/venv/bin"
EnvironmentFile=/var/www/aurex/.env

# Start command
ExecStart=/var/www/aurex/python-backend/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 4 \
    --log-level info

# Restart policy
Restart=always
RestartSec=5s

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/aurex

# Limits
LimitNOFILE=65536
TimeoutStartSec=60s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
