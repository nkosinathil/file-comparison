[Unit]
Description=Aurex Celery Worker for Background Processing
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=aurex
Group=aurex
WorkingDirectory=/var/www/aurex/python-backend

# Environment
Environment="PATH=/var/www/aurex/python-backend/venv/bin"
EnvironmentFile=/var/www/aurex/.env

# Start command
ExecStart=/var/www/aurex/python-backend/venv/bin/celery -A app.celery worker \
    --loglevel=info \
    --concurrency=4 \
    --max-tasks-per-child=100

# Restart policy
Restart=always
RestartSec=5s

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/aurex

# Limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
