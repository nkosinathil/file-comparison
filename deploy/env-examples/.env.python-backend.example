# ==============================================================================
# Aurex Python Backend - Environment Configuration
# Server: 192.168.1.90 (Python Processing Server)
# ==============================================================================

# Application Settings
APP_NAME=Aurex Python Backend
APP_VERSION=1.0.0
APP_ENV=production  # development, staging, production
DEBUG=false
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# FastAPI Settings
API_HOST=0.0.0.0
API_PORT=8001
API_WORKERS=4
API_RELOAD=false  # Set to true only in development

# Security
API_SECRET_KEY=<generate_with_openssl_rand_hex_32>
# Generate with: openssl rand -hex 32
API_CORS_ORIGINS=http://192.168.1.66,https://192.168.1.66
# Comma-separated list of allowed origins for CORS

# Internal API Key (for PHP -> Python communication)
INTERNAL_API_KEY=<generate_strong_random_key>
# This key should match the one in PHP .env file

# Database (PostgreSQL on Application Server)
DB_HOST=192.168.1.66
DB_PORT=5432
DB_NAME=aurex_db
DB_USER=aurex_app_user
DB_PASSWORD=<postgres_user_password>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis (Celery Broker and Result Backend)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password_if_auth_enabled>
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Celery Settings
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_TIME_LIMIT=3600  # 1 hour max per task
CELERY_TASK_SOFT_TIME_LIMIT=3300  # 55 minutes soft limit

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=<minio_access_key>
MINIO_SECRET_KEY=<minio_secret_key>
MINIO_SECURE=false  # Set to true if using HTTPS
MINIO_BUCKET_UPLOADS=aurex-uploads
MINIO_BUCKET_RESULTS=aurex-results
MINIO_BUCKET_EXPORTS=aurex-exports
MINIO_REGION=us-east-1

# File Processing Settings
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=pdf
TEMP_UPLOAD_DIR=/tmp/aurex/uploads
TEMP_PROCESSING_DIR=/tmp/aurex/processing

# AI Chat Settings (Ollama)
ENABLE_AI_CHAT=true
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=120  # seconds

# PDF Processing Settings
PDF_DPI=300  # DPI for image conversion if OCR is needed
TESSERACT_PATH=/usr/bin/tesseract  # Path to tesseract binary
ENABLE_OCR_FALLBACK=true

# Monitoring and Logging
SENTRY_DSN=  # Optional: Sentry error tracking
LOG_FILE_PATH=/var/log/aurex/backend.log
LOG_FILE_MAX_BYTES=10485760  # 10MB
LOG_FILE_BACKUP_COUNT=5
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_LOGGING=true

# Rate Limiting (Future)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# Feature Flags
ENABLE_NETWORK_GRAPH=true
ENABLE_CATEGORY_AUTO_CLASSIFICATION=true
ENABLE_DUPLICATE_DETECTION=true

# Paths (Legacy Logic)
LEGACY_SCRIPTS_DIR=/opt/aurex/python-backend/app/legacy_logic

# Development Settings (only for local development)
# RELOAD_ON_CHANGE=true
# MOCK_MINIO=false
# MOCK_REDIS=false
