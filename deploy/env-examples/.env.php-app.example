# ==============================================================================
# Aurex PHP Application - Environment Configuration
# Server: 192.168.1.66 (Application Server)
# ==============================================================================

# Application Settings
APP_NAME="Aurex Bank Statement Intelligence"
APP_ENV=production  # development, staging, production
APP_DEBUG=false
APP_URL=http://192.168.1.66  # Public URL of the application
APP_TIMEZONE=UTC

# Security
APP_KEY=<generate_with_php_bin_random_32>
# Generate with: php -r "echo bin2hex(random_bytes(32));"
SESSION_DRIVER=file  # file, database, redis
SESSION_LIFETIME=60  # minutes
SESSION_SECURE_COOKIE=false  # Set to true when using HTTPS
SESSION_SAME_SITE=lax  # lax, strict, none

# CSRF Protection
CSRF_TOKEN_NAME=_token
CSRF_HEADER_NAME=X-CSRF-TOKEN

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=localhost  # PostgreSQL is on same server
DB_PORT=5432
DB_DATABASE=aurex_db
DB_USERNAME=aurex_app_user
DB_PASSWORD=<postgres_user_password>
DB_CHARSET=utf8
DB_SCHEMA=public

# Python Backend API
PYTHON_API_BASE_URL=http://192.168.1.90:8001
PYTHON_API_TIMEOUT=30  # seconds
PYTHON_API_KEY=<internal_api_key>
# This must match INTERNAL_API_KEY in Python backend .env

# Keycloak SSO (on 192.168.1.59)
KEYCLOAK_BASE_URL=http://192.168.1.59:8080
KEYCLOAK_REALM=<your_realm_name>
KEYCLOAK_CLIENT_ID=<your_client_id>
KEYCLOAK_CLIENT_SECRET=<your_client_secret>
KEYCLOAK_REDIRECT_URI=${APP_URL}/auth/callback
KEYCLOAK_LOGOUT_REDIRECT_URI=${APP_URL}/

# Keycloak Endpoints (auto-constructed, but can override)
KEYCLOAK_AUTH_ENDPOINT=${KEYCLOAK_BASE_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/auth
KEYCLOAK_TOKEN_ENDPOINT=${KEYCLOAK_BASE_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/token
KEYCLOAK_USERINFO_ENDPOINT=${KEYCLOAK_BASE_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/userinfo
KEYCLOAK_LOGOUT_ENDPOINT=${KEYCLOAK_BASE_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/logout

# MinIO (S3-Compatible Storage on Python Server)
MINIO_ENDPOINT=192.168.1.90:9000
MINIO_ACCESS_KEY=<minio_access_key>
MINIO_SECRET_KEY=<minio_secret_key>
MINIO_USE_SSL=false  # Set to true if MinIO uses HTTPS
MINIO_REGION=us-east-1
MINIO_BUCKET_UPLOADS=aurex-uploads
MINIO_BUCKET_RESULTS=aurex-results
MINIO_BUCKET_EXPORTS=aurex-exports

# File Upload Settings
UPLOAD_MAX_SIZE=104857600  # 100MB in bytes
UPLOAD_ALLOWED_EXTENSIONS=pdf
UPLOAD_TEMP_DIR=/tmp/aurex_uploads

# Logging
LOG_CHANNEL=daily  # single, daily, syslog
LOG_LEVEL=info  # debug, info, notice, warning, error, critical, alert, emergency
LOG_PATH=/var/www/gismartanalytics/storage/logs

# Redis (Optional - for session storage or caching)
REDIS_HOST=192.168.1.90
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password_if_enabled>
REDIS_DATABASE=1  # Use different DB than Python backend

# Cache Settings
CACHE_DRIVER=file  # file, redis, database
CACHE_PREFIX=aurex_cache
CACHE_TTL=3600  # Default cache time in seconds

# Mail Settings (for notifications - optional)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<smtp_username>
MAIL_PASSWORD=<smtp_password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@aurex.local
MAIL_FROM_NAME="${APP_NAME}"

# Job Polling Settings
JOB_POLL_INTERVAL=3  # seconds between status checks
JOB_POLL_MAX_DURATION=3600  # max seconds to poll before timeout

# UI Settings
UI_ITEMS_PER_PAGE=20
UI_DATE_FORMAT="Y-m-d H:i:s"
UI_TIMEZONE=${APP_TIMEZONE}

# Feature Flags
ENABLE_AI_CHAT=true
ENABLE_NETWORK_VISUALIZATION=true
ENABLE_EXPORT_DOWNLOADS=true
ENABLE_USER_REGISTRATION=false  # Managed via Keycloak

# Security Headers
SECURITY_HSTS_ENABLED=false  # Enable when using HTTPS
SECURITY_FRAME_OPTIONS=DENY
SECURITY_XSS_PROTECTION=1; mode=block
SECURITY_CONTENT_TYPE_OPTIONS=nosniff

# Development Settings (only for local development)
# DEV_TOOLBAR_ENABLED=true
# SQL_DEBUG_LOG=true
