# Aurex - Environment Configuration Template
# Copy this file to .env and update with your values

# Environment Configuration
API_BASE_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
LOG_LEVEL=info

# PHP Configuration
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=50M
PHP_POST_MAX_SIZE=50M
PHP_DISPLAY_ERRORS=false  # Set to true only in development

# Security - JWT Secret
JWT_SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-IN-PRODUCTION

# SSO Configuration
SSO_ENABLED=false
SSO_PROVIDER=oauth  # oauth or saml

# OAuth Configuration
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=https://your-domain.com/oauth/callback
OAUTH_PROVIDER_URL=https://oauth.provider.com

# SAML Configuration
SAML_IDP_URL=https://idp.provider.com/saml
SAML_SP_ENTITY_ID=https://your-domain.com

# Security
SECURE_COOKIES=true  # Set to true in production with HTTPS
JWT_SECRET_KEY=change-this-to-a-random-secret-key

# Database (if using external database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aurex
DB_USER=aurex
DB_PASSWORD=change-this-password

# File Storage
UPLOAD_PATH=/var/www/html/uploads
DATA_PATH=/var/www/html/data

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# SSL/TLS (for production)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Monitoring (optional)
ENABLE_MONITORING=false
SENTRY_DSN=

# Logging
LOG_PATH=/var/log/aurex
LOG_MAX_SIZE=100M
LOG_MAX_FILES=10
